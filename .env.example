# Copy to .env before starting. Values are read with plain std::env::var; there is
# no dotenv crate in the binary, so Docker Compose supplies the environment in
# production and your shell supplies it in development.

# ─── Application ──────────────────────────────────────────────────────────────
# Must be the EXACT public URL. The session cookie's Secure flag and the CSRF
# Origin check are both derived from it.
APP_PUBLIC_URL=https://finanzen.example.org
APP_BIND=0.0.0.0:3100
# Allows booting without a strong session secret, and downgrades the RLS-bypass
# check from a hard failure to a warning. Never true in production.
APP_DEV_MODE=false
# At least 32 characters. Changing it logs everyone out.  openssl rand -base64 48
APP_SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_SESSION_TTL_SECONDS=2592000
APP_TIMEZONE=Europe/Berlin
APP_DATA_DIR=/app/data
APP_FRONTEND_DIR=/app/frontend-dist
# Upper bound for spreadsheet and receipt uploads, in bytes (25 MiB). Keep
# client_max_body_size in the nginx config in step with this.
APP_MAX_UPLOAD_BYTES=26214400
RUST_LOG=finanzen=info,tower_http=info
HOST_PORT=3100
CONTAINER_IMAGE=ghcr.io/your-github-owner/finanzen
IMAGE_TAG=latest

# ─── Database ─────────────────────────────────────────────────────────────────
# POSTGRES_USER is a superuser and is used only to initialise the cluster.
POSTGRES_DB=finanzen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# The role the application actually connects as. It owns its database, so sqlx can
# run migrations at boot, but it is NOT a superuser — a superuser bypasses
# row-level security unconditionally and would make tenant isolation inert. The
# backend refuses to start if its role can bypass RLS.
APP_DB_USER=finanzen_app
APP_DB_PASSWORD=replace-with-another-strong-password
DB_MAX_CONNECTIONS=10
DB_CONNECT_TIMEOUT_SECONDS=10

# ─── Authentication ───────────────────────────────────────────────────────────
AUTH_PROVIDER=local
# Registration is closed by default: the first run creates an admin, and further
# accounts are created by that admin.
AUTH_ALLOW_REGISTRATION=false
AUTH_ALLOW_AUTO_PROVISION=false
# Reserved for the OIDC provider, which the Authenticator trait is already shaped
# for. Unused while AUTH_PROVIDER=local.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ADMIN_GROUP=

# ─── KitchenOwl ───────────────────────────────────────────────────────────────
# Leave the URL or the token empty to disable the integration completely: the
# periodic loops do not start, the widget reports "not configured", and nothing
# else in the application is affected.
#
# KitchenOwl is a SEPARATE, PARALLEL LEDGER. Its expenses are mirrored locally and
# are never summed with the personal bookings; pulled items land as drafts and are
# never auto-booked. The two will not fully reconcile, by design.
KITCHENOWL_URL=https://kitchenowl.example.org
KITCHENOWL_TOKEN=replace-with-a-long-lived-token
# Leave empty only when the token can see exactly one household.
KITCHENOWL_HOUSEHOLD_ID=
KITCHENOWL_HTTP_TIMEOUT_SECONDS=30

# Every interval below: 0 disables that loop entirely, any other value is floored
# at 60 seconds.
KITCHENOWL_EXPENSE_POLL_SECONDS=900
KITCHENOWL_METADATA_REFRESH_SECONDS=86400
KITCHENOWL_PUSH_RETRY_SECONDS=300
KITCHENOWL_SYNC_ON_START=true
# Cached members and expense categories older than this are served with a staleness
# warning rather than withheld, so the push dialogue still opens when KitchenOwl is
# unreachable.
KITCHENOWL_METADATA_STALE_SECONDS=172800
KITCHENOWL_MAX_PULL_PAGES=40
KITCHENOWL_PUSH_MAX_ATTEMPTS=10
# The idempotency marker normally goes in the expense description. Set true to put
# it in the name instead: KitchenOwl's own search only matches the name, which makes
# reconciliation server-side at the cost of a visible suffix in its UI.
KITCHENOWL_PUSH_MARKER_IN_NAME=false
# Score at or above which a pulled expense is flagged as a likely duplicate of an
# existing booking and pre-selected for linking instead of creating.
KITCHENOWL_DUPLICATE_THRESHOLD=0.80

# ─── Import ───────────────────────────────────────────────────────────────────
# Jaro-Winkler gate for fuzzy category suggestions. Measured against the real 240
# unknown comments, 0.92 keeps the few correct matches and suppresses the
# confident-but-wrong ones (trinken->tanken, Malve->Mafit, iPad->Pfand). Lowering
# it produces suggestions that get accepted by reflex and are wrong.
IMPORT_FUZZY_MIN_CONFIDENCE=0.92
# Resolving a review item also writes a comment->category rule, so the same
# merchant is never asked about twice and future imports benefit.
IMPORT_AUTO_CREATE_RULE=true
IMPORT_MAX_ROWS=20000

# Where the database and receipts live on the host. Bind-mounted into both
# containers, so a backup script sees plain directories rather than having to
# reach into /var/lib/docker. Anything outside the repo works too:
#   DATA_ROOT=/srv/finanzen
DATA_ROOT=./data
