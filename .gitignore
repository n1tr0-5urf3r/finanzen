# secrets
.env

# rust
backend/target/
**/*.rs.bk

# node
# No trailing slash: a worktree agent symlinks this rather than installing it, and
# a trailing slash matches a directory but not a symlink — which would let a
# careless `git add -A` commit a link to someone else's checkout.
node_modules
frontend/dist/
*.tsbuildinfo

# data
data/
*.db
*.db-*

# editors / os
.DS_Store
.idea/
.vscode/

# source spreadsheets — personal financial data, never commit
*.xlsx
*.ods
# ...except the tiny invented workbooks the readers are tested against. They carry
# the SHAPE of the real files and none of their data; monthly_shape.py rebuilds them.
!backend/tests/fixtures/*.xlsx

# extracted golden fixtures — derived from the source spreadsheets, so they carry
# the same personal financial data. Regenerate with:
#   cargo run --bin extract-fixtures -- ../konten_2026_auswertung.xlsx ../konten.ods tests/fixtures
backend/tests/fixtures/*.json
.claude/
data/
backups/
